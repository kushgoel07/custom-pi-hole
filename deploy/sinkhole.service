[Unit]
Description=Custom Go DNS sinkhole
Wants=network-online.target
After=network-online.target

[Service]
DynamicUser=yes
WorkingDirectory=/opt/sinkhole
# Replace the listen IP and client subnet with your actual LAN values.
ExecStart=/opt/sinkhole/sinkhole -listen 192.168.1.10:53 -clients 127.0.0.0/8,192.168.1.0/24 -blocklist /opt/sinkhole/blocklist.txt
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
